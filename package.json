{
  "name": "nest-cartograph",
  "version": "0.1.0",
  "description": "Map a NestJS app's modules, providers and injections from its source code, then explore the map in your browser.",
  "keywords": [
    "nestjs",
    "nest",
    "dependency-graph",
    "dependency-injection",
    "ast",
    "visualization",
    "react-flow",
    "cli"
  ],
  "license": "MIT",
  "author": "Ittikorn Chawkamud",
  "type": "module",
  "bin": {
    "nest-cartograph": "dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build:cli && npm run build:ui",
    "build:cli": "tsc -p tsconfig.build.json",
    "build:ui": "vite build --config ui/vite.config.ts",
    "dev:ui": "npm run build:cli && node dist/cli/index.js analyze -p test/fixtures/tsconfig.json -o ui/public/cartograph.json && vite --config ui/vite.config.ts",
    "test": "vitest run",
    "test:update": "vitest run -u",
    "lint": "oxlint src ui/src test",
    "typecheck": "tsc -p tsconfig.json && tsc -p ui/tsconfig.json",
    "check:pkg": "publint && attw --pack . --profile esm-only",
    "prepublishOnly": "npm run build && npm run check:pkg"
  },
  "dependencies": {
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@nestjs/common": "^12.1.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@xyflow/react": "^12.12.0",
    "elkjs": "^0.12.0",
    "oxlint": "^1.88.0",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5"
  }
}
